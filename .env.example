# Server
PORT=3000
HOST=127.0.0.1

# CORS
CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_HEADERS=Content-Type,Authorization,X-Request-ID
CORS_CREDENTIALS=false

# Authentication
JWT_SECRET=change-me-in-production
COOKIE_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRY=7m
REFRESH_TOKEN_EXPIRY=7d
REFRESH_TOKEN_MAX_AGE=604800000
AUTH_EXCLUDE_PATHS=/health,/auth/api/v1/token-refresh,/student/api/v1/login,/student/api/v1/register,/student/api/v1/email,/student/api/v1/password-reset,/student/api/v1/verify-email

# Rate Limiting (global fallback)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Proxy signature (shared secret with upstream services)
PROXY_SECRET=change-me-in-production

# Routes (JSON array)
# Each route maps a path prefix to a backend service URL
# rateLimit.strategy: "fixedWindow" or "tokenBucket"
# rateLimit.windowMs: window duration in ms (fixedWindow)
# rateLimit.max: max requests per window (fixedWindow) or bucket capacity (tokenBucket)
# rateLimit.refillRate: tokens per second (tokenBucket only)
ROUTES=[
  {"prefix":"auth/api","target":"http://localhost:3000", "rateLimit": {"strategy": "fixedWindow", "windowMs": 900000, "max": 100}},
  {"prefix":"/student/api","target":"http://localhost:8001", "rateLimit": {"strategy": "fixedWindow", "windowMs": 900000, "max": 100}},
]
